# ==============================================================================
# MintKitchen Backend Configuration (Example Template)
# Copy this file to .env and adjust variables as needed:
#   copy .env.example .env
# ==============================================================================

# Database Connection URL (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mintkitchen

# PostgreSQL with psycopg2 driver explicitly:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mintkitchen

# SQLite fallback (for local development or testing without PostgreSQL):
# DATABASE_URL=sqlite:///./recipes.db

# JWT Authentication
JWT_SECRET_KEY=spo-products-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
